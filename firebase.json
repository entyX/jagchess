{
  "hosting": [
    {
      "site": "nchs-chess-club",
      "public": "redirect",
      "ignore": [
        "firebase.json",
        ".firebaserc",
        "**/.*",
        "**/node_modules/**"
      ],
      "redirects": [
        {
          "source": "/",
          "destination": "https://jagchess.web.app/",
          "type": 301
        },
        {
          "source": "/:path*",
          "destination": "https://jagchess.web.app/:path*",
          "type": 301
        }
      ]
    },
    {
      "site": "jagchess",
      "public": ".",
      "ignore": [
        "firebase.json",
        ".firebaserc",
        ".gitignore",
        "node_modules/**",
        "redirect/**",
        ".vercel/**",
        ".claude/**",
        "package.json",
        "package-lock.json",
        "example.png",
        "assets/js/firebase-config.example.js",
        "**/client_secret*.json",
        "**/*adminsdk*.json",
        "**/*service-account*.json",
        "**/serviceAccountKey*.json",
        "firestore.rules",
        "tests/**"
      ],
      "cleanUrls": true,
      "trailingSlash": false,
      "rewrites": [
        {
          "source": "/m/**",
          "destination": "/match.html"
        },
        {
          "source": "/admin",
          "destination": "/admin/dashboard.html"
        },
        {
          "source": "/student",
          "destination": "/student/dashboard.html"
        },
        {
          "source": "/signup",
          "destination": "/login.html"
        },
        {
          "source": "/clubs/**",
          "destination": "/club.html"
        },
        {
          "source": "/tournaments/**",
          "destination": "/tournaments.html"
        },
        {
          "source": "/players/**",
          "destination": "/tournaments.html"
        }
      ],
      "headers": [
        {
          "source": "**",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache, must-revalidate"
            }
          ]
        },
        {
          "source": "**/*.@(css|js)",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=0, must-revalidate"
            }
          ]
        },
        {
          "source": "**/*.@(png|jpg|jpeg|svg|webp|woff2|ico)",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=604800"
            }
          ]
        }
      ]
    }
  ],
  "firestore": {
    "rules": "firestore.rules"
  }
}
